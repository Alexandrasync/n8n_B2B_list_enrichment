      "parameters": {
        "jsCode": "// Берем текущий текст ошибки\nlet errorMessage = $json.error?.message || \"Unknown error\";\n\n// Если текст слишком длинный, обрезаем его до 1000 символов и добавляем троеточие\nif (errorMessage.length > 1000) {\n  errorMessage = errorMessage.substring(0, 1000) + '... [Текст ошибки обрезан]';\n}\n\n// Возвращаем обновленный объект, который теперь безопасно записывать в Google Sheets\nreturn {\n  ...$json,\n  error: {\n    ...$json.error,\n    message: errorMessage\n  }\n};\n"
      },
