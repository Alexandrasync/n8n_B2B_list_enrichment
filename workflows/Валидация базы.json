    {
      "parameters": {
        "functionCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const text = item.json.text;\n\n  if (!text) {\n    return {\n      json: {\n        ...item.json,\n        text: null\n      }\n    };\n  }\n\n  return {\n    json: {\n      ...item.json,\n      text: text.length > 8000 ? text.slice(0, 8000) : text\n    }\n  };\n});"
      },
      "id": "fe669ac7-4b0f-4def-9dfa-cbe35c05f353",
      "name": "Limit Text",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        112,
        160
      ],
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "functionCode": "return items.map(item => {\n  const html = item.json.body || item.json.data || item.json;\n\n  if (!html) {\n    return null; // можно отфильтровать позже\n  }\n\n  const text = html\n    .toString()\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, '')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n\n  return {\n    json: {\n      ...item.json, // важно: сохраняем исходные данные!\n      text\n    }\n  };\n}).filter(Boolean);"
      },
